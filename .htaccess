RewriteEngine On

# ============================================================
# 1. Jangan ubah URL jika permintaan adalah POST (Login/AJAX)
# ============================================================
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^ - [L]

# ============================================================
# 2. Redirect jika user mengetik manual .php di browser
# ============================================================
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# ============================================================
# 3. Hilangkan ekstensi .php dari URL secara internal
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# ============================================================
# 4. Hilangkan ekstensi .html dari URL secara internal
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# ============================================================
# 5. PENANGANAN 404 (Dinamis untuk Subfolder / Localhost)
# Jika file atau folder tidak ditemukan, arahkan ke 404.php
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]